rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SECURITY AUDIT & RBAC HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roleName) {
      return isSignedIn() && userDocExists() && getUserDoc().role == roleName;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
        || (userDocExists() && getUserDoc().role == 'SUPER_ADMIN')
        || (request.auth.token != null && request.auth.token.superAdmin == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin()
        || (userDocExists() && getUserDoc().role == 'ADMIN')
        || exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        || exists(/databases/$(database)/documents/adminAuthorizations/$(request.auth.uid))
        || existsAfter(/databases/$(database)/documents/adminAuthorizations/$(request.auth.uid))
      );
    }

    function isVerifiedDoctor() {
      return isSignedIn() && (
        (userDocExists() && getUserDoc().role == 'DOCTOR' && getUserDoc().verificationStatus == 'VERIFIED')
        || (exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
            && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.verificationStatus == 'VERIFIED')
        || isAdmin()
      );
    }

    function isVerifiedNurse() {
      return isSignedIn() && (
        (userDocExists() && getUserDoc().role == 'NURSE' && getUserDoc().verificationStatus == 'VERIFIED')
        || (exists(/databases/$(database)/documents/nurses/$(request.auth.uid))
            && get(/databases/$(database)/documents/nurses/$(request.auth.uid)).data.verificationStatus == 'VERIFIED')
        || isAdmin()
      );
    }

    function isHospitalStaffMember(hospitalId) {
      return isSignedIn() && userDocExists()
        && getUserDoc().hospitalId == hospitalId
        && (getUserDoc().role == 'DOCTOR' || getUserDoc().role == 'NURSE' || getUserDoc().role == 'ADMIN')
        && getUserDoc().verificationStatus == 'VERIFIED';
    }

    function isHospitalAdmin(hospitalId) {
      return isSuperAdmin() || (
        isAdmin() && userDocExists() && getUserDoc().hospitalId == hospitalId
      );
    }

    function hasAcceptedConnection(connectionId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/connections/$(connectionId))
          && get(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'Accepted'
          && (
            get(/databases/$(database)/documents/connections/$(connectionId)).data.patientUid == request.auth.uid
            || get(/databases/$(database)/documents/connections/$(connectionId)).data.doctorUid == request.auth.uid
          ))
        ||
        (existsAfter(/databases/$(database)/documents/connections/$(connectionId))
          && getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.status == 'Accepted'
          && (
            getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.patientUid == request.auth.uid
            || getAfter(/databases/$(database)/documents/connections/$(connectionId)).data.doctorUid == request.auth.uid
          ))
      );
    }

    // =========================================================================
    // 1. IDENTITY & PROFILES (Users, Patients, Doctors, Nurses, Admins)
    // =========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /patients/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /doctors/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /nurses/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /adminAuthorizations/{authUid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /administrators/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. DOCTOR REQUESTS, CONNECTIONS, SECURE CHAT & CONVERSATIONS
    // =========================================================================
    match /doctorRequests/{requestId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /connections/{connectionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || hasAcceptedConnection(conversationId)
            || isAdmin());

      allow create, update: if isSignedIn()
        && (request.resource.data.patientUid == request.auth.uid
            || request.resource.data.doctorUid == request.auth.uid
            || hasAcceptedConnection(conversationId)
            || isAdmin());

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && (hasAcceptedConnection(conversationId) || isAdmin());
        allow create, update: if isSignedIn() && (hasAcceptedConnection(conversationId) || isAdmin());
        allow delete: if false;
      }
    }

    // =========================================================================
    // 3. CLINICAL RECORDS: APPOINTMENTS, PRESCRIPTIONS, LABS & CALENDAR
    // =========================================================================
    match /appointments/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow create: if isSignedIn()
        && (request.resource.data.patientUid == request.auth.uid
            || request.resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow update: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow delete: if isAdmin();
    }

    match /prescriptions/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin()
            || isVerifiedNurse());

      allow create: if isSignedIn() && (isVerifiedDoctor() || isAdmin());
      allow update: if isSignedIn() && (resource.data.doctorUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /laboratoryRequests/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow create: if isSignedIn() && (isVerifiedDoctor() || isAdmin());
      allow update: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow delete: if isAdmin();
    }

    match /laboratoryReports/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow create, update: if isSignedIn()
        && (request.resource.data.patientUid == request.auth.uid
            || request.resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow delete: if isAdmin();
    }

    match /calendarEvents/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || resource.data.nurseUid == request.auth.uid
            || isAdmin());

      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /medicalRecords/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || isVerifiedNurse()
            || isAdmin());

      allow create, update: if isSignedIn()
        && (request.resource.data.patientUid == request.auth.uid
            || request.resource.data.doctorUid == request.auth.uid
            || isAdmin());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. SMART PATIENT JOURNEY
    // =========================================================================
    match /patientJourneys/{journeyId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.attendingDoctorUid == request.auth.uid
            || isVerifiedNurse()
            || isAdmin());

      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. COMMUNITY AND HOSPITAL FEED & COMMENTS
    // =========================================================================
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isVerifiedDoctor() || isAdmin());
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /postComments/{commentId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // 6. HOSPITAL OPERATIONS: OT, WARDS, BEDS, NURSING TASKS & VITALS
    // =========================================================================
    match /operations/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid
            || resource.data.nurseUid == request.auth.uid
            || isVerifiedNurse()
            || isAdmin());

      allow create, update: if isSignedIn() && (isVerifiedDoctor() || isVerifiedNurse() || isAdmin());
      allow delete: if isAdmin();
    }

    match /operationRooms/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isVerifiedDoctor() || isVerifiedNurse() || isAdmin());
      allow delete: if isAdmin();
    }

    match /wards/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isVerifiedDoctor() || isVerifiedNurse() || isAdmin());
      allow delete: if isAdmin();
    }

    match /beds/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isVerifiedDoctor() || isVerifiedNurse() || isAdmin());
      allow delete: if isAdmin();
    }

    match /nurseAssignments/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() || isVerifiedNurse();
    }

    match /nursingTasks/{docId} {
      allow read: if isSignedIn()
        && (resource.data.nurseUid == request.auth.uid
            || resource.data.patientUid == request.auth.uid
            || isAdmin()
            || isVerifiedDoctor());

      allow create, update: if isSignedIn() && (isVerifiedNurse() || isVerifiedDoctor() || isAdmin());
      allow delete: if isAdmin();
    }

    match /vitals/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.nurseUid == request.auth.uid
            || isVerifiedDoctor()
            || isAdmin());

      allow create: if isSignedIn() && (isVerifiedNurse() || isVerifiedDoctor() || isAdmin());
      allow update: if isSignedIn() && (resource.data.nurseUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. E-PHARMACY, EMERGENCY HEALTH CARDS & FAMILY HEALTH PROFILES
    // =========================================================================
    match /pharmacyProducts/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /pharmacyOrders/{docId} {
      allow read: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.patientUid == request.auth.uid;

      allow update: if isSignedIn()
        && (resource.data.patientUid == request.auth.uid || isAdmin());

      allow delete: if isAdmin();
    }

    match /emergencyProfiles/{patientUid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (patientUid == request.auth.uid || request.resource.data.patientUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /familyMembers/{memberId} {
      allow read: if isSignedIn()
        && (resource.data.primaryPatientUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.primaryPatientUid == request.auth.uid;

      allow update, delete: if isSignedIn()
        && (resource.data.primaryPatientUid == request.auth.uid || isAdmin());
    }

    match /hospitalDepartments/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7.1 GLOBAL HOSPITAL NETWORK & MULTI-TENANT ACCESS (Phase 9)
    // =========================================================================
    match /hospitals/{hospitalId} {
      // Public discovery: anyone (including unauthenticated users) can view accredited hospitals
      allow read: if true;
      // Institutions can apply for registration
      allow create: if isSignedIn();
      // Super Admin manages approvals, codes, and activations
      allow update, delete: if isSuperAdmin();

      // =========================================================================
      // Phase 12: Hospital Authority Communication Hub (Strict Multi-Tenant)
      // =========================================================================
      match /conversations/{conversationId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId)
              || (isHospitalStaffMember(hospitalId)
                  && (resource.data.conversationType == 'GROUP_DOCTORS' && getUserDoc().role == 'DOCTOR'
                      || resource.data.conversationType == 'GROUP_NURSES' && getUserDoc().role == 'NURSE'
                      || (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids))));

        allow create, update: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId) || isHospitalStaffMember(hospitalId));

        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isSignedIn()
            && resource.data.hospitalId == hospitalId
            && (isHospitalAdmin(hospitalId) || isHospitalStaffMember(hospitalId));

          allow create: if isSignedIn()
            && request.resource.data.hospitalId == hospitalId
            && request.resource.data.senderUid == request.auth.uid
            && (isHospitalAdmin(hospitalId) || isHospitalStaffMember(hospitalId));

          allow update: if isSignedIn()
            && resource.data.hospitalId == hospitalId
            && (isHospitalAdmin(hospitalId) || isHospitalStaffMember(hospitalId));

          allow delete: if false;
        }
      }

      // =========================================================================
      // Phase 13: Payment & Billing Architecture (Hospital-Scoped)
      // =========================================================================
      match /bills/{billId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId)
              || resource.data.patientUid == request.auth.uid
              || isHospitalStaffMember(hospitalId));

        allow create: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId) || isVerifiedDoctor());

        // Clients cannot self-mark bills as SUCCESSFUL or REFUNDED without trusted verification / Admin
        allow update: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && request.resource.data.hospitalId == hospitalId
          && request.resource.data.totalAmountBdt == resource.data.totalAmountBdt
          && (isHospitalAdmin(hospitalId)
              || (resource.data.patientUid == request.auth.uid
                  && (request.resource.data.status == 'PROCESSING' || request.resource.data.status == 'CANCELLED')));

        allow delete: if isSuperAdmin();
      }

      match /receipts/{receiptId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId)
              || resource.data.patientUid == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && isHospitalAdmin(hospitalId);

        // Receipts are immutable financial records
        allow update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId) || resource.data.patientUid == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId) || request.resource.data.patientUid == request.auth.uid);

        allow update, delete: if false;
      }

      match /refundRequests/{refundId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId) || resource.data.requestedByUid == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && request.resource.data.requestedByUid == request.auth.uid;

        allow update: if isHospitalAdmin(hospitalId);
        allow delete: if false;
      }

      // =========================================================================
      // Phase 14: Ambulance Dispatch & Authorized Live Telemetry
      // =========================================================================
      match /ambulanceRequests/{requestId} {
        allow read: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId)
              || isHospitalStaffMember(hospitalId)
              || resource.data.patientUid == request.auth.uid
              || resource.data.driverUid == request.auth.uid);

        allow create: if isSignedIn()
          && request.resource.data.hospitalId == hospitalId
          && request.resource.data.patientUid == request.auth.uid
          && request.resource.data.status == 'Requested';

        allow update: if isSignedIn()
          && resource.data.hospitalId == hospitalId
          && request.resource.data.hospitalId == hospitalId
          && (isHospitalAdmin(hospitalId)
              || (resource.data.driverUid == request.auth.uid
                  && resource.data.status != 'Completed'
                  && resource.data.status != 'Cancelled')
              || (resource.data.patientUid == request.auth.uid
                  && request.resource.data.status == 'Cancelled'
                  && (resource.data.status == 'Requested' || resource.data.status == 'Accepted')));

        allow delete: if isSuperAdmin();
      }
    }

    match /hospitalMemberships/{membershipId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 8. AUDIT LOGS (TAMPER-PROOF & IMMUTABLE)
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // STRICT IMMUTABILITY
    }
  }
}

    <!-- Onboarding -->
    <string name="onboarding_title_1">Connected Care Ecosystem</string>
    <string name="onboarding_desc_1">Seamlessly linking patients, verified doctors, nurses, laboratories, operation theatres, and pharmacies into one unified medical journey.</string>
    <string name="onboarding_badge_1">END-TO-END WORKFLOW</string>

    <string name="onboarding_title_2">Authorized Clinical Trust</string>
    <string name="onboarding_desc_2">Every specialist and nursing professional undergoes strict hospital credential verification. Medical records and communications are protected by permission-based access.</string>
    <string name="onboarding_badge_2">VERIFIED PROFESSIONALS</string>

    <string name="onboarding_title_3">Synchronized Health Timeline</string>
    <string name="onboarding_desc_3">From consultation requests and digital prescriptions to laboratory diagnostics and post-operative follow-ups, every step updates in real time.</string>
    <string name="onboarding_badge_3">SMART PATIENT JOURNEY</string>


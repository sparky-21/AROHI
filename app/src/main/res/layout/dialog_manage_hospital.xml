<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/arohi_ivory_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Super Admin • Hospital Governance"
            android:textColor="@color/arohi_moss_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/manageHospitalSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Verify Institution &amp; Assign Network Code"
            android:textColor="@color/arohi_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/arohi_card_stroke" />

        <!-- Hospital Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hospital Name"
            app:boxBackgroundColor="@color/arohi_card_bg"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/arohi_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etManageHospitalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/arohi_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Hospital Code -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Unique Hospital Code (e.g. SQUARE-01)"
            app:boxBackgroundColor="@color/arohi_card_bg"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/arohi_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etManageHospitalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/arohi_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- City & Hotline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="City"
                app:boxBackgroundColor="@color/arohi_card_bg"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/arohi_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etManageCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/arohi_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Total Beds"
                app:boxBackgroundColor="@color/arohi_card_bg"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/arohi_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etManageTotalBeds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/arohi_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Verification Toggle Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Accredited &amp; Verified Hospital"
            android:textColor="@color/arohi_text_primary"
            android:textSize="14sp" />

        <!-- Active Status Toggle Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchActivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Activate for Public Discovery &amp; Ops"
            android:textColor="@color/arohi_text_primary"
            android:textSize="14sp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/arohi_moss_green"
                app:cornerRadius="8dp"
                app:strokeColor="@color/arohi_moss_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/arohi_moss_green"
                android:text="Save Hospital"
                android:textColor="@color/arohi_ivory_cream"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

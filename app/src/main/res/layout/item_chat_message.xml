<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Incoming Message Bubble (Aligned Start) -->
    <LinearLayout
        android:id="@+id/layoutIncomingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_card_elevated"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvIncomingSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Sender"
            android:textColor="@color/arohi_teal_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvIncomingMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Message content"
            android:textColor="@color/arohi_charcoal_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvIncomingTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="10:15 AM"
            android:textColor="@color/arohi_slate_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Outgoing Message Bubble (Aligned End) -->
    <LinearLayout
        android:id="@+id/layoutOutgoingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_hero_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvOutgoingMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Outgoing message content"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvOutgoingMetaAndRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="10:16 AM • Sent"
            android:textColor="@color/arohi_mint_tint"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>

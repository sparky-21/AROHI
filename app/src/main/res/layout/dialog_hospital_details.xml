<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/arohi_ivory_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogHospitalName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AROHI Central Research &amp; Hospital"
                    android:textColor="@color/arohi_moss_green"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogHospitalCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Dhaka, Bangladesh"
                    android:textColor="@color/arohi_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialogHospitalCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_role_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="AROHI-HQ"
                android:textColor="@color/arohi_moss_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/arohi_card_stroke" />

        <!-- Status & Capacity Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogVerificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_verified"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="✓ ACCREDITED INSTITUTION"
                android:textColor="@color/arohi_moss_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogBedCapacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_role_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🛏️ 500 Operational Beds"
                android:textColor="@color/arohi_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/dialogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="Premier tertiary multi-specialty research and teaching healthcare facility within the AROHI Global Network."
            android:textColor="@color/arohi_text_primary"
            android:textSize="14sp" />

        <!-- Address Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Location &amp; Address"
            android:textColor="@color/arohi_moss_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Plot 12, Health Sciences Avenue, Dhaka-1212"
            android:textColor="@color/arohi_text_secondary"
            android:textSize="13sp" />

        <!-- Emergency Hotline with Call Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_role_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Triage &amp; Hotline (24/7)"
                    android:textColor="@color/arohi_moss_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogHotline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+880 1800-AROHI"
                    android:textColor="@color/arohi_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallHotline"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="@color/arohi_moss_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Call"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="6dp" />
        </LinearLayout>

        <!-- Departments List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Clinical Specialties &amp; Departments"
            android:textColor="@color/arohi_moss_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogDepartmentsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="• Cardiology\n• Neurology\n• Emergency &amp; Trauma\n• General Medicine\n• Pediatrics\n• Orthopedics\n• ICU &amp; Critical Care"
            android:textColor="@color/arohi_text_primary"
            android:textSize="13sp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnClose"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/action_close"
                android:textColor="@color/arohi_moss_green"
                app:cornerRadius="8dp"
                app:strokeColor="@color/arohi_moss_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnSelectAndProceed"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/arohi_moss_green"
                android:text="Select Hospital"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
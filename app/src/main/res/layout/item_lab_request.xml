<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Test Name, Category & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabTestName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Complete Blood Count (CBC)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLabCategoryAndUrgency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hematology • Urgency: Routine"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLabStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="REQUESTED"
                android:textColor="@color/status_warning"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Doctor & Patient Info -->
        <TextView
            android:id="@+id/tvLabDoctorAndPatient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ordered by Dr. Specialist for Patient"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Findings & Review Summary -->
        <TextView
            android:id="@+id/tvLabFindingsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_white_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Sample collected • Report processing in laboratory"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Doctor Review Note if present -->
        <TextView
            android:id="@+id/tvLabDoctorReviewNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Doctor Review: None"
            android:textColor="@color/status_verified"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Actions Row: Responsive equal weights -->
        <LinearLayout
            android:id="@+id/layoutLabActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabUploadReport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="Upload Report"
                android:textColor="@color/primary_moss_green"
                android:textSize="11sp"
                app:strokeColor="@color/primary_moss_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabDoctorReview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="Doctor Review"
                android:textColor="@color/status_warning"
                android:textSize="11sp"
                app:strokeColor="@color/status_warning" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLabViewReport"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="View Report"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

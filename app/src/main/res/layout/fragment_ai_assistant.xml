<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="@color/deep_forest_green"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnAiBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_sub"
                android:textColor="@color/soft_sage"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnConfigureAiApi"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_settings"
            app:tint="@color/white"
            android:contentDescription="Configure AI API" />
    </LinearLayout>

    <!-- Prominent Demo Mode / Educational Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDemoBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/status_warning_bg"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/status_warning"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDemoBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ai_demo_banner"
                android:textColor="@color/status_warning"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Suggested Quick Prompts Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPromptNpo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/ai_chip_npo"
                android:textColor="@color/accent_heading"
                android:textSize="11sp"
                app:strokeColor="@color/border_focused" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPromptIcu"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="@string/ai_chip_icu"
                android:textColor="@color/accent_heading"
                android:textSize="11sp"
                app:strokeColor="@color/border_focused" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPromptBp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="@string/ai_chip_bp"
                android:textColor="@color/accent_heading"
                android:textSize="11sp"
                app:strokeColor="@color/border_focused" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPromptBook"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="@string/ai_chip_appt"
                android:textColor="@color/accent_heading"
                android:textSize="11sp"
                app:strokeColor="@color/border_focused" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipPromptRecords"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="@string/ai_chip_rx"
                android:textColor="@color/accent_heading"
                android:textSize="11sp"
                app:strokeColor="@color/border_focused" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAiChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/surface_card">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAiQueryInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_subtle"
            android:hint="@string/hint_ask_ai"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendAiQuery"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/deep_forest_green"
            android:text="@string/action_send"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arohi_soft_ivory"
    android:orientation="vertical">

    <!-- Top Secure Chat Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_forest_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnChatBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_mint"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatCounterpartyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Participant Name"
                android:textColor="@color/arohi_pure_white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvChatConnectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="VERIFIED CONNECTION • END-TO-END FIRESTORE"
                android:textColor="@color/arohi_mint_tint"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspectCounterpartyProfile"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Profile"
            android:textAllCaps="false"
            android:textColor="@color/arohi_forest_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/arohi_pure_white"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Security Gate Banner if Connection is Not Accepted / Unauthorized -->
    <LinearLayout
        android:id="@+id/bannerChatAccessDenied"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_status_error"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="SECURE MESSAGING LOCKED"
            android:textColor="@color/arohi_crimson_alert"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvChatAccessDeniedReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Only accepted doctor-patient connections are permitted to exchange messages."
            android:textColor="@color/arohi_charcoal_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Empty Chat State -->
    <TextView
        android:id="@+id/tvEmptyChatMessages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_elevated"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="20dp"
        android:text="Your consultation connection is Accepted. Send a message below to start your clinical conversation."
        android:textColor="@color/arohi_slate_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Message Composer Bar -->
    <LinearLayout
        android:id="@+id/layoutChatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/arohi_pure_white"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChatMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_elevated"
            android:hint="Type a secure clinical message..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:fontFamily="sans-serif-bold"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="@color/arohi_pure_white"
            app:backgroundTint="@color/arohi_forest_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

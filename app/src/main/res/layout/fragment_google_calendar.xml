<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8F4">

    <!-- Google Calendar Top App Bar (Moss Green Theme) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/primary_moss_green">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnGoogleCalendarBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="Back" />

        <!-- Month Title with Dropdown Arrow (e.g. "Nov 2026 ▾") -->
        <TextView
            android:id="@+id/tvGoogleMonthTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:text="Nov 2026 ▾"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Search Icon -->
        <ImageButton
            android:id="@+id/btnCalendarSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search"
            app:tint="@color/white"
            android:contentDescription="Search" />

        <!-- Today Date Badge Box (e.g. "8") -->
        <TextView
            android:id="@+id/tvCalendarTodayBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_calendar_today_badge" />

        <!-- Checkmark / Tasks Icon -->
        <ImageButton
            android:id="@+id/btnCalendarTasks"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/white"
            android:contentDescription="Tasks" />

        <!-- Switch to Standard View Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchToStandardCalendar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Standard"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:strokeColor="@color/white"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- Day-of-Week Header Labels (Sun Mon Tue Wed Thu Fri Sat) in Soft Sage / Pale Mint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:background="#E8EFE2">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sun"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mon"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tue"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wed"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thu"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Fri"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sat"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Header Divider in Subtle Moss Border -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#D5E0CE" />

    <!-- Main Content Frame: Month Grid with Floating Moss Green FAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Month Grid (6 rows x 7 days) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:background="#F7F8F4">

            <LinearLayout
                android:id="@+id/layoutMonthGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <!-- 6 week-rows dynamically generated -->
            </LinearLayout>
        </ScrollView>

        <!-- Google Calendar Floating Action Button (Moss Green FAB at bottom right) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabGoogleBookEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primary_moss_green"
            android:contentDescription="Create Event"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            app:tint="@color/white"
            app:srcCompat="@drawable/ic_add" />

        <!-- Hidden Recycler and Empty State for binding compatibility -->
        <LinearLayout
            android:id="@+id/layoutGoogleCalendarEmpty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerGoogleCalendar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
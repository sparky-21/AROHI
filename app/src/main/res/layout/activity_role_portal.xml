<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Top Portal App Bar -->
    <LinearLayout
        android:id="@+id/topPortalBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/deep_forest_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_arohi_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPortalHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:singleLine="true"
                android:text="AROHI PORTAL"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="13.5sp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tvPortalHeaderSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:singleLine="true"
                android:text="ID: AROHI-0000"
                android:textColor="@color/soft_sage"
                android:textSize="10.5sp"
                app:autoSizeMaxTextSize="10.5sp"
                app:autoSizeMinTextSize="7.5sp"
                app:autoSizeStepGranularity="0.5sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPortalStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_badge_pill"
            android:lines="1"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/status_verified"
            android:textColor="@color/text_primary"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <!-- Emergency Alert SOS Trigger -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeaderEmergencyAlert"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/status_emergency"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <ImageButton
            android:id="@+id/btnHeaderCommunityFeed"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle_mint"
            android:contentDescription="@string/nav_community_feed"
            android:padding="5dp"
            android:src="@drawable/ic_nav_messages"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnHeaderSettings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_circle_mint"
            android:contentDescription="@string/settings_title"
            android:padding="5dp"
            android:src="@drawable/ic_nav_settings"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnHeaderRefresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_circle_mint"
            android:contentDescription="@string/action_retry"
            android:padding="5dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Main Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topPortalBar" />

    <!-- Role-Specific Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        app:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconTint="@color/nav_item_color_selector"
        app:itemTextColor="@color/nav_item_color_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

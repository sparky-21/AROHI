<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTimelineTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tracking_timeline_title"
        android:textColor="@color/accent_heading"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogTimelineSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Status progression &amp; audit trail"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogTimelineSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:maxHeight="300dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogLiveMap"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/tracking_btn_live_map"
            android:textAllCaps="false"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary_moss_green" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogAdvanceStage"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/tracking_btn_advance_stage"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:visibility="gone"
            app:backgroundTint="@color/deep_forest_green"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogTimelineClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/action_close"
        android:textAllCaps="false"
        app:backgroundTint="@color/primary_moss_green"
        app:cornerRadius="12dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_curved"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AROHI HEALTHCARE ECOSYSTEM"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Official Digital Prescription • Valid Health Record"
                android:textColor="@color/soft_sage"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Doctor Details Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvViewRxDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Specialist, MBBS, FCPS"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewRxDoctorMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Specialist in General Medicine • BMDC Reg: 12345"
                android:textColor="@color/primary_moss_green"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_stroke" />

        <!-- Patient Demographics Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_pill"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvViewRxPatientLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient: Name • ID: AROHI-PAT-0001 • Blood: A+"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewRxVitalsLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vitals: BP: 120/80 mmHg • Temp: 98.6°F"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Diagnosis Block -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="DIAGNOSIS:"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvViewRxDiagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Acute Bronchitis &amp; Upper Respiratory Tract Infection"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Rx Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rx (Prescribed Medicines):"
            android:textColor="@color/primary_moss_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Medicines Content Text -->
        <TextView
            android:id="@+id/tvViewRxMedicinesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_white_pill"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="1. Amoxicillin 500mg • 1+1+1 (7 Days) - After Meal\n2. Paracetamol 500mg • 1+0+1 (3 Days) - After Meal"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Advice & Follow-up -->
        <TextView
            android:id="@+id/tvViewRxAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Advice: Rest, drink plenty of warm fluids."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvViewRxFollowUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Follow-up Date: 2026-11-20"
            android:textColor="@color/status_warning"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Digital Verification Badge -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_badge_pill"
            android:padding="8dp"
            android:text="✔ Electronically Verified Digital Prescription • AROHI Clinical Network"
            android:textColor="@color/status_verified"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseViewRx"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/action_close"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadRxPdf"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Export PDF"
                android:textColor="@color/accent_heading"
                app:strokeColor="@color/border_focused" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderPrescriptionMedicines"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/deep_forest_green"
                android:text="Order Medicines"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.AROHI.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/card_elevation"
        app:strokeColor="@color/soft_sage"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_circle_mint">

                <ImageView
                    android:id="@+id/ivOnboardingIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_arohi_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvOnboardingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:text="@string/onboarding_badge_1"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AROHI.Caption"
                android:textColor="@color/accent_heading"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOnboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center"
                android:text="@string/onboarding_title_1"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AROHI.HeadlineMedium" />

            <TextView
                android:id="@+id/tvOnboardingDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:text="@string/onboarding_desc_1"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AROHI.BodyLarge"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

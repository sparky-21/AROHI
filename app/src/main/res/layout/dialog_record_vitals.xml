<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecordVitalsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Patient Vital Observations"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecordVitalsPatientSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Patient: Karim Ahmed • Ward A Bed 101"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp" />

        <!-- Blood Pressure -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVitalsBp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Blood Pressure (e.g. 120/80 mmHg) *"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVitalsBp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="120/80"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Heart Rate & Temp Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVitalsHr"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Heart Rate (bpm)"
                app:boxStrokeColor="@color/primary_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVitalsHr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="76"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVitalsTemp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Temp (°F)"
                app:boxStrokeColor="@color/primary_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVitalsTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="98.6"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- SpO2 & Resp Rate Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVitalsSpO2"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Oxygen SpO2 (%)"
                app:boxStrokeColor="@color/primary_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVitalsSpO2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="98"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilVitalsRr"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Resp Rate (/min)"
                app:boxStrokeColor="@color/primary_moss_green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVitalsRr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="18"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Clinical Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVitalsNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Nurse Observation Notes (optional)"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVitalsNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:text="Patient comfortable, alert and oriented. Nil distress."
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelVitals"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveVitals"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/primary_moss_green"
                android:text="Save Vitals"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

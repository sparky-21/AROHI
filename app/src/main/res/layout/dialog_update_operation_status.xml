<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUpdateOpStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Surgical Operation Status"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateOpProcedureSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Laparoscopic Cholecystectomy • Karim Ahmed"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp" />

        <!-- Status Selection Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSelectOpStatus"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Select Operation Status"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvSelectOpStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp"  android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Post-Op Notes / Findings -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPostOpNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Post-Operative Surgeon Findings &amp; Notes"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPostOpNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="3"
                android:text="Procedure uneventful. Minimal blood loss. Transferred to PACU recovery."
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Follow-Up Date -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOpFollowUpDate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Follow-up Date (YYYY-MM-DD)"
            app:boxStrokeColor="@color/primary_moss_green"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOpFollowUpDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:text="2026-11-16"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelUpdateStatus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/action_cancel"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitUpdateStatus"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/primary_moss_green"
                android:text="Save Status"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
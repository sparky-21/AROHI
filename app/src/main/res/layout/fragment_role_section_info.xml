<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arohi_soft_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Section Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvSectionPhaseBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_pill"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="LIVE FIRESTORE MODULE"
                android:textColor="@color/arohi_forest_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:text="Module Title"
                android:textColor="@color/arohi_pure_white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSectionSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Connected to Cloud Firestore collection."
                android:textColor="@color/arohi_mint_tint"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Live Firestore Count Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/arohi_pure_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/arohi_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Live Cloud Firestore Records"
                    android:textColor="@color/arohi_slate_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSectionLiveCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0 Active Records"
                    android:textColor="@color/arohi_forest_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvSectionLiveDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="Real-time status fetched from Firebase Firestore."
                    android:textColor="@color/arohi_charcoal_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Honest Phase Roadmap & Verification Gate Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/arohi_pure_white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/arohi_border_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvSectionUpcomingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Module Availability &amp; Roadmap"
                    android:textColor="@color/arohi_charcoal_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSectionUpcomingBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="Detailed interactive workflows for this module are scheduled for the upcoming phase. Zero fake or hardcoded records are displayed."
                    android:textColor="@color/arohi_slate_muted"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReturnToDashboard"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="14dp"
                    android:text="Return to Main Dashboard"
                    android:textAllCaps="false"
                    android:textColor="@color/arohi_forest_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/arohi_sage_mist"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

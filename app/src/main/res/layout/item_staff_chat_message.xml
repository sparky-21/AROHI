<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Incoming Message Bubble (Aligned Start) -->
    <LinearLayout
        android:id="@+id/layoutIncomingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bg_white_pill"
        android:backgroundTint="@color/surface_card"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="visible">

        <!-- Sender Header with Role Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIncomingSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Raisa Ahmed"
                android:textColor="@color/accent_heading"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingSenderRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:lines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:singleLine="true"
                android:text="DOCTOR"
                android:textColor="@color/primary_moss_green"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Message Body -->
        <TextView
            android:id="@+id/tvIncomingMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="2dp"
            android:text="Clinical duty update and ICU schedule."
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <!-- Attachment Preview Box (Optional) -->
        <LinearLayout
            android:id="@+id/layoutIncomingAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIncomingAttachmentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄 "
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvIncomingAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="ICU_Schedule_2026.pdf"
                android:textColor="@color/primary_moss_green"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Timestamp & Read State -->
        <TextView
            android:id="@+id/tvIncomingTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="10:15 AM"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Outgoing Message Bubble (Aligned End) -->
    <LinearLayout
        android:id="@+id/layoutOutgoingBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_white_pill"
        android:backgroundTint="@color/primary_moss_green"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <!-- Outgoing Message Body -->
        <TextView
            android:id="@+id/tvOutgoingMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="Acknowledged. Rotations confirmed."
            android:textColor="@color/white"
            android:textSize="13.5sp" />

        <!-- Attachment Preview Box (Optional) -->
        <LinearLayout
            android:id="@+id/layoutOutgoingAttachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/pale_mint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvOutgoingAttachmentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📎 "
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOutgoingAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Clinical_Guidelines.pdf"
                android:textColor="@color/deep_forest_green"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Timestamp and Delivery/Read Checkmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOutgoingTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:16 AM"
                android:textColor="@color/soft_sage"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvOutgoingReadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="✓✓"
                android:textColor="@color/soft_sage"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

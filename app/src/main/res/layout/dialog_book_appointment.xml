<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBookApptDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Consultation Appointment"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBookApptDoctorSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Doctor: Select Doctor • Fee: 500 BDT"
            android:textColor="@color/primary_moss_green"
            android:textSize="13sp" />

        <!-- Doctor Spinner if choosing from list -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSelectDoctor"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Select Doctor"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvSelectDoctor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date Picker Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAppointmentDate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Appointment Date (YYYY-MM-DD)"
            app:boxStrokeColor="@color/primary_moss_green"
            app:endIconDrawable="@drawable/ic_calendar"
            app:endIconMode="custom">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAppointmentDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Time Slot Selection Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAppointmentTime"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Select Time Slot"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvAppointmentTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Consultation Type Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConsultationType"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Consultation Type"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvConsultationType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Consultation Reason -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAppointmentReason"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Reason for Consultation *"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAppointmentReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Patient Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAppointmentNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Additional Health Notes (optional)"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAppointmentNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Conflict Prevention Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_white_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="System automatically validates doctor availability and prevents double-booking or scheduling conflicts."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelBookAppt"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitBookAppt"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/primary_moss_green"
                android:text="Confirm Booking"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

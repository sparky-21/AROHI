<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/divider_color" />

    <!-- Header: Icon, Location Name, Floor Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/pale_mint"
            android:gravity="center"
            android:text="📍"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDirectionsDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency &amp; Trauma Centre"
                android:textAppearance="@style/TextAppearance.AROHI.TitleLarge"
                android:textColor="@color/accent_heading"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDirectionsDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ground Floor • West Wing • Room G-01"
                android:textAppearance="@style/TextAppearance.AROHI.Caption"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDirectionsDialogClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider_color" />

    <!-- Step by Step Instructions Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.AROHI.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeColor="@color/border_focused"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶 Step-by-Step Walking Directions"
                android:textAppearance="@style/TextAppearance.AROHI.TitleMedium"
                android:textColor="@color/accent_heading"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutDirectionsStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Hours & Extension Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDirectionsDialogHours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hours: 24 Hours / 7 Days"
            android:textColor="@color/accent_heading"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDirectionsDialogExtension"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ext: 101, 102"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDirectionsStart3DNav"
        style="@style/Widget.AROHI.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start 3D Indoor Turn-by-Turn Navigation ➔" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDirectionsViewOnFloorPlan"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="View On Schematic Floor Plan"
        android:textColor="@color/primary_moss_green" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E5E3DF">

    <!-- Google Maps Top Search & Route Planning Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoutePlanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Title & Switch Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnGoogleMapBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#5F6368"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Indoor Hospital Navigation"
                    android:textColor="#202124"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Option to switch back to Standard Map -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchToStandardMap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Standard Map"
                    android:textColor="#1A73E8"
                    android:textSize="11sp"
                    app:strokeColor="#1A73E8" />
            </LinearLayout>

            <!-- Route Inputs: Start & Destination (Hidden during live navigation) -->
            <LinearLayout
                android:id="@+id/layoutRoutePlannerInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left Start/End Icons Column -->
                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_badge_verified" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:background="#BDC1C6" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_error" />
                </LinearLayout>

                <!-- Spinners for Start & Destination -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Spinner
                        android:id="@+id/spinnerStartLocation"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_card_subtle"
                        android:paddingHorizontal="6dp" />

                    <Spinner
                        android:id="@+id/spinnerDestinationLocation"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_card_subtle"
                        android:paddingHorizontal="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Floor Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupGoogleFloors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGFloorGround"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Ground Floor" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGFloor1"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floor 1" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGFloor2"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floor 2" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGFloor3"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floor 3 (ICU/OT)" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGFloorB"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basement" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Google Maps Active Turn-by-Turn Navigation Green Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActiveNavBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#188038"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Turn Maneuver Icon -->
            <TextView
                android:id="@+id/tvNavManeuverIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="⬆"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Instructions Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNavStepDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In 20 meters"
                    android:textColor="#E8F0FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNavCurrentInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Head toward Central Elevator Hub"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNavNextPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Then take elevator to Floor 3"
                    android:textColor="#CEEAD6"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNavCloseBanner"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/white"
                android:contentDescription="Exit Navigation" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Interactive Google Maps Vector View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.arohi.healthcare.views.GoogleMapHospitalView
            android:id="@+id/googleHospitalMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Hint Pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_white_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="💡 Tap any room on map to navigate"
            android:textColor="#5F6368"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Google Maps Bottom Navigation Bottom Sheet Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Route Summary Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGoogleRouteTimeEstimate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 min (85 meters)"
                        android:textColor="#188038"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGoogleRouteAlgorithmBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fastest walking route • via Central Elevators"
                        android:textColor="#5F6368"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleStepDetails"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Steps"
                    android:textColor="#1A73E8"
                    android:textSize="12sp"
                    app:strokeColor="#1A73E8" />
            </LinearLayout>

            <!-- Turn-by-Turn Steps Container (Expandable in Overview Mode) -->
            <LinearLayout
                android:id="@+id/layoutTurnByTurnSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="#F8F9FA"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 Turn-by-Turn Navigation Steps:"
                    android:textColor="#202124"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTurnByTurnInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Head toward Elevator Hub.\n2. Take Elevator to destination."
                    android:textColor="#3C4043"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Overview Mode: Start Navigation Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNavigation"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1A73E8"
                android:text="🧭 Start Navigation"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- Active Navigation Mode Controls Container -->
            <LinearLayout
                android:id="@+id/layoutActiveNavControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Step Counter & Remaining Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvNavStepProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 1 of 5"
                        android:textColor="#202124"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavRemainingStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85m • 2 min"
                        android:textColor="#188038"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Navigation Progress Bar -->
                <ProgressBar
                    android:id="@+id/navProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#1A73E8" />

                <!-- Navigation Action Buttons (Exit / Next Step) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavExit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="✕ Exit"
                        android:textColor="#D93025"
                        android:textSize="13sp"
                        app:strokeColor="#D93025" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavNextStep"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="2"
                        android:backgroundTint="#1A73E8"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Next Step ➔"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
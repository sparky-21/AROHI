<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Hospital Name, Code, and Distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHospitalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Square Hospital Dhaka"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHospitalCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Code: SQUARE-01"
                    android:textColor="@color/primary_moss_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDistanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill"
                android:lines="1"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:text="1.8 km away"
                android:textColor="@color/primary_moss_green"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Address Line -->
        <TextView
            android:id="@+id/tvHospitalAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="18/F, West Panthapath, Dhaka-1205"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Status Badges & Beds -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVerificationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:lines="1"
                android:maxLines="1"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                android:text="✓ AROHI VERIFIED"
                android:textColor="@color/status_verified"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="400 Beds"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHotline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Hotline: +880 1713-377775"
                android:textColor="@color/status_emergency"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Departments Preview -->
        <TextView
            android:id="@+id/tvDepartmentsPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Cardiology • Critical Care • Emergency Medicine • Surgery"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/border_stroke" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemDirections"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pale_mint"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_get_directions"
                android:textColor="@color/deep_forest_green"
                android:textSize="12sp"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_directions"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/deep_forest_green" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemSelect"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primary_moss_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/action_select_hospital"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="19dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Drag Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/border_muted" />

    <!-- Group Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvGroupInfoAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/pale_mint"
            android:gravity="center"
            android:text="🩺"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGroupInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Doctors Group"
                android:textColor="@color/accent_heading"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGroupInfoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Verified Active Clinical Staff"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tenancy Notice Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_white_pill"
        android:backgroundTint="@color/badge_pending_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ Hospital Multi-Tenant Isolation"
            android:textColor="@color/badge_pending_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGroupTenancyNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingExtra="2dp"
            android:text="Access is strictly restricted to active verified clinical staff belonging to this hospital. Membership updates automatically based on credential verification."
            android:textColor="@color/text_primary"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Member Count Summary -->
    <TextView
        android:id="@+id/tvGroupMemberCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Verified Members (8 Active)"
        android:textColor="@color/accent_heading"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Staff Roster Container -->
    <TextView
        android:id="@+id/tvGroupRosterSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="• Dr. Raisa Ahmed (Cardiology)\n• Dr. Tariqul Islam (Neurology)\n• Hospital Authority (Administrator)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Moderation & Reporting Policy -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="📌 Policy: All communication is audited for clinical safety. Inappropriate messages can be reported and moderated by hospital authority."
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGroupInfoClose"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/primary_moss_green"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:cornerRadius="10dp" />

</LinearLayout>

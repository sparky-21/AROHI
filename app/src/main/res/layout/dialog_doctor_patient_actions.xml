<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Dialog Header -->
        <TextView
            android:id="@+id/tvPatientActionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient: Name"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPatientActionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Clinical Actions &amp; Care Coordination"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:background="@color/divider_color" />

        <!-- Action: Issue Digital Prescription -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionPrescription"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Issue Digital Prescription (Rx)"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_check_circle"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: Order Diagnostic Lab Test -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionLabTest"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Order Diagnostic Laboratory Test"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_search"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: Schedule Consultation Appointment -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionScheduleAppt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Schedule Consultation Appointment"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: Schedule Hospital Operation (OT) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionScheduleOperation"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Schedule Hospital Operation (OT)"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_emergency_cross"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: View Patient Medical Record Timeline -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionMedicalRecord"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="View Patient Medical Record Timeline"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_nav_records"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: Open Secure Chat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionSecureChat"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Open 1-to-1 Secure Chat"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_nav_messages"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Action: Inspect Full Health Demographics -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionDemographics"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Inspect Full Health Demographics"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_card"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_role_patient"
            app:iconGravity="start"
            app:iconPadding="14dp"
            app:iconSize="20dp"
            app:iconTint="@color/primary_moss_green"
            app:rippleColor="@color/pale_mint"
            app:strokeColor="@color/border_stroke"
            app:strokeWidth="1dp" />

        <!-- Close Button (Prominent pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClosePatientActions"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/deep_forest_green"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pale_mint"
            app:cornerRadius="23dp"
            app:strokeColor="@color/primary_moss_green"
            app:strokeWidth="1.5dp" />

    </LinearLayout>
</ScrollView>
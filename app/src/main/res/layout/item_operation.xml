<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Procedure Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOperationName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Laparoscopic Cholecystectomy"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOperationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Scheduled"
                android:textColor="@color/primary_moss_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Room, Date & Time -->
        <TextView
            android:id="@+id/tvOperationDateTimeAndRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📅 2026-11-09 at 10:00 AM • OT Suite 2 - General"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Surgical Team & Patient -->
        <TextView
            android:id="@+id/tvOperationPatientAndDoctor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Patient: Karim Ahmed (AROHI-PAT-KRM1)\nSurgeon: Dr. Raisa (General Surgery)\nAssisting Nurse: Sister Fatima (RN)"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Pre-op Checklist Indicators -->
        <TextView
            android:id="@+id/tvOperationChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_white_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="✓ NPO  ✓ Anesthesia  ✓ Consent  ✓ Blood  ✓ Pre-Op Antibiotic"
            android:textColor="@color/status_verified"
            android:textSize="11sp" />

        <!-- Post-Op Notes / Follow-Up Date (if any) -->
        <TextView
            android:id="@+id/tvOperationFollowUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Follow-up Date: 2026-11-16"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOperationChecklist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Checklist"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateOperationStatus"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="@color/primary_moss_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Update Status"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

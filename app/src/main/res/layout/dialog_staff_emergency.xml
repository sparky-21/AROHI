<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/divider_color" />

    <!-- Staff Emergency Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="@color/status_emergency_bg"
            android:gravity="center"
            android:text="🚨"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BROADCAST EMERGENCY ALERT"
                android:textAppearance="@style/TextAppearance.AROHI.TitleLarge"
                android:textColor="@color/status_emergency"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStaffEmergencySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sends urgent alert to Authority group &amp; triggers beep alarm"
                android:textAppearance="@style/TextAppearance.AROHI.Caption"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnStaffEmergencyClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider_color" />

    <!-- Emergency Category Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Emergency Type:"
        android:textAppearance="@style/TextAppearance.AROHI.TitleMedium"
        android:textColor="@color/accent_heading"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupEmergencyType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rbCodeBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Code Blue (Cardiac / Respiratory Arrest)"
            android:textColor="@color/status_emergency"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rbResuscitation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Critical Resuscitation / Trauma Alert"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbIcuMassCasualty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mass Casualty / Emergency ICU Assistance"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbUrgentClinical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Urgent Clinical &amp; Security Support"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <!-- Location / Ward / Room Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ward / Bed / OT Room Location:"
        android:textAppearance="@style/TextAppearance.AROHI.TitleMedium"
        android:textColor="@color/accent_heading"
        android:textSize="13sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etStaffEmergencyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Ward 4B, Bed 12 - Severe Cardiac Arrest"
            android:inputType="textCapSentences"
            android:textSize="13.5sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Trigger Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStaffBroadcastEmergency"
        style="@style/Widget.AROHI.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/status_emergency"
        android:text="🚨 Broadcast Urgent Alert to Authority &amp; Group"
        android:textColor="@color/white" />

</LinearLayout>

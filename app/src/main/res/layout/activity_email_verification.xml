<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_horizontal_padding">

        <include
            android:id="@+id/toolbar"
            layout="@layout/include_auth_toolbar" />

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_icon_circle_mint">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/email_verification_title"
                android:src="@drawable/ic_email" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/email_verification_title"
            android:textAppearance="@style/TextAppearance.AROHI.HeadlineLarge" />

        <TextView
            android:id="@+id/tvVerificationEmailTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/email_verification_subtitle"
            android:textAppearance="@style/TextAppearance.AROHI.BodyMedium" />

        <include
            android:id="@+id/stateView"
            layout="@layout/include_loading_error_state" />

        <!-- Verification Instructions Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AROHI.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why Email Verification Matters"
                    android:textAppearance="@style/TextAppearance.AROHI.TitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="1. Real Email: Click the verification link sent to your inbox, then tap 'I Have Verified My Email'.\n2. Demo / Test Email: If using a demo Gmail without a real inbox, tap 'Demo Email: Verify &amp; Continue' below."
                    android:textAppearance="@style/TextAppearance.AROHI.BodyMedium" />

                <TextView
                    android:id="@+id/tvCurrentEmailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_badge_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Status: Awaiting Verification"
                    android:textAppearance="@style/TextAppearance.AROHI.Caption"
                    android:textColor="@color/deep_forest_green"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckVerification"
            style="@style/Widget.AROHI.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_check_verification" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResendVerification"
            style="@style/Widget.AROHI.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/action_resend_verification" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueToProfileSetup"
            style="@style/Widget.AROHI.Button.DeepForest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Demo Email: Verify &amp; Continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignOut"
            style="@style/Widget.AROHI.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_sign_out"
            android:textColor="@color/status_emergency" />

    </LinearLayout>
</ScrollView>

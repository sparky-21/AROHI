<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Diagnostic Laboratory Test"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLabPatientHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Patient: Name • ID: AROHI-PAT-0001"
            android:textColor="@color/primary_moss_green"
            android:textSize="13sp" />

        <!-- Quick Test Selector or Custom Test Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Select or Type Diagnostic Test *"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvTestName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Test Category -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Test Category"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvTestCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Clinical Indication / Reason -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Clinical Indication / Diagnostic Reason *"
            app:boxStrokeColor="@color/primary_moss_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabIndication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Urgency Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Urgency Level"
            app:boxStrokeColor="@color/primary_moss_green">

            <AutoCompleteTextView
                android:id="@+id/actvLabUrgency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCreateLab"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/border_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitCreateLab"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/primary_moss_green"
                android:text="Order Test"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

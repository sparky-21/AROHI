<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Title & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ceftriaxone 1g IV Infusion"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/filter_pending"
                android:textColor="@color/status_warning"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Type & Scheduled Time -->
        <TextView
            android:id="@+id/tvTaskTypeAndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="💊 Medication • Scheduled Today at 10:00 AM • Priority: High"
            android:textColor="@color/primary_moss_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Patient & Bed info -->
        <TextView
            android:id="@+id/tvTaskPatientAndLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Patient: Karim Ahmed (AROHI-PAT-KRM1) • Ward A Bed 101"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- Description / Instructions -->
        <TextView
            android:id="@+id/tvTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Slow IV infusion in 100ml Normal Saline over 30 mins"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Doctor Instruction Quote -->
        <LinearLayout
            android:id="@+id/layoutDoctorInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_white_pill"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvDoctorInstructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr. Raisa: Monitor for any hypersensitivity reaction"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Completion Notes (if completed) -->
        <TextView
            android:id="@+id/tvNurseCompletionNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Completed: Administered as prescribed. Vitals normal."
            android:textColor="@color/status_verified"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Complete Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompleteTask"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="@color/primary_moss_green"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="Mark Completed"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
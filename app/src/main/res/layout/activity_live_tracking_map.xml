<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface_card"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnLiveMapBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/accent_heading" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLiveMapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_map_title"
                android:textColor="@color/accent_heading"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveMapStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: On the Way"
                android:textColor="@color/primary_moss_green"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveMapEtaPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_pill"
            android:backgroundTint="@color/status_verified_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ETA: --"
            android:textColor="@color/status_verified"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Honest Telemetry / Session Guard Notice -->
    <LinearLayout
        android:id="@+id/bannerTelemetryNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/badge_pending_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTelemetryNoticeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/tracking_map_no_telemetry"
            android:textColor="@color/badge_pending_text"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Map Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/liveTrackingMapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutMapConfigFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️"
                android:textSize="38sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Google Maps API Key Required"
                android:textColor="@color/accent_heading"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Configure MAPS_API_KEY in local.properties to display Google Maps tiles. Telemetry metadata below remains synced."
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Driver / Partner Info Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLivePartnerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Assigned Driver / Delivery Partner"
                android:textColor="@color/accent_heading"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLivePartnerDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vehicle &amp; Destination metadata"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallLivePartner"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/tracking_btn_call_partner"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_moss_green"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primary_moss_green" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

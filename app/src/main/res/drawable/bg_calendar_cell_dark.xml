<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Warm Ivory / Soft Moss Surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_background" />
        </shape>
    </item>
    <!-- Subtle Moss Green Grid Border -->
    <item
        android:left="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="@color/border_stroke" />
        </shape>
    </item>
</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Warm Ivory / Soft Moss Surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F7F8F4" />
        </shape>
    </item>
    <!-- Subtle Moss Green Grid Border -->
    <item
        android:left="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#D5E0CE" />
        </shape>
    </item>
</layer-list>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme for Night/Dark Mode -->
    <style name="Theme.AROHI" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Color Tokens -->
        <item name="colorPrimary">@color/primary_moss_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pale_mint</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <item name="colorSecondary">@color/secondary_sage</item>
        <item name="colorOnSecondary">@color/deep_forest_green</item>
        <item name="colorSecondaryContainer">@color/surface_subtle</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>

        <item name="colorTertiary">@color/soft_sage</item>
        <item name="colorOnTertiary">@color/deep_forest_green</item>

        <item name="colorError">@color/status_emergency</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/status_emergency_bg</item>
        <item name="colorOnErrorContainer">@color/status_emergency</item>

        <!-- Background & Surfaces -->
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:colorBackground">@color/surface_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_subtle</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_stroke</item>

        <!-- Global Typography Defaults -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="editTextColor">@color/text_primary</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/deep_forest_green</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Default Component Styles -->
        <item name="materialButtonStyle">@style/Widget.AROHI.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.AROHI.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.AROHI.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AROHI.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AROHI.MaterialAlertDialog</item>
    </style>

    <!-- Splash Theme in Dark Mode -->
    <style name="Theme.AROHI.Splash" parent="Theme.AROHI">
        <item name="android:windowBackground">@color/deep_forest_green</item>
        <item name="android:statusBarColor">@color/deep_forest_green</item>
        <item name="android:navigationBarColor">@color/deep_forest_green</item>
    </style>

    <!-- Dark Button Overrides -->
    <style name="Widget.AROHI.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/primary_moss_green</item>
        <item name="cornerRadius">@dimen/input_corner_radius</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.AROHI.Button.DeepForest" parent="Widget.AROHI.Button.Primary">
        <item name="backgroundTint">#274930</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.AROHI.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/soft_sage</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/input_corner_radius</item>
    </style>

    <style name="Widget.AROHI.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/soft_sage</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dark TextInputLayout Override (fixes white input boxes in dark mode) -->
    <style name="Widget.AROHI.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_card</item>
        <item name="boxStrokeColor">@color/border_focused</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="hintTextColor">@color/soft_sage</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="errorTextColor">@color/status_emergency</item>
        <item name="boxStrokeErrorColor">@color/status_emergency</item>
    </style>

    <!-- Dark Dialog Theming -->
    <style name="ThemeOverlay.AROHI.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:colorBackground">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AROHI.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AROHI.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AROHI.Dialog.Button.Negative</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AROHI.Dialog</item>
    </style>

    <style name="Widget.AROHI.Dialog.Button.Positive" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/primary_moss_green</item>
        <item name="cornerRadius">19dp</item>
    </style>

    <style name="Widget.AROHI.Dialog.Button.Negative" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface_subtle</item>
        <item name="strokeColor">@color/border_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">19dp</item>
    </style>
</resources>

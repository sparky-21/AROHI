<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ArohiApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_arohi_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_arohi_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AROHI">

        <!-- 1. Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AROHI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Onboarding Screens -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Role Selection Screen -->
        <activity
            android:name=".activities.RoleSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Patient Registration -->
        <activity
            android:name=".activities.PatientRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Doctor Registration -->
        <activity
            android:name=".activities.DoctorRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Nurse Registration -->
        <activity
            android:name=".activities.NurseRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Authorized Admin Setup -->
        <activity
            android:name=".activities.AdminSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 9. Forgot Password Screen -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 10. Email Verification Screen -->
        <activity
            android:name=".activities.EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11. Basic Profile Setup & Role Verification Gate -->
        <activity
            android:name=".activities.BasicProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 12. Role-Based Portal & Dashboards (Patient, Doctor, Nurse, Admin) -->
        <activity
            android:name=".activities.RolePortalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 13. Secure One-to-One Doctor-Patient Chat Activity -->
        <activity
            android:name=".activities.SecureChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 14. FileProvider for Exported PDF Prescriptions and Diagnostic Reports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ArohiApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_arohi_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_arohi_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AROHI">

        <!-- Google Maps API Key Meta-Data -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- 1. Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AROHI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Onboarding Screens -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2.1 Hospital Discovery & Network Selection (Phase 9 Multi-Tenant Gateway) -->
        <activity
            android:name=".activities.HospitalDiscoveryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2.2 Global Hospital Discovery & Nearby Finder (Phase 11 Google Maps) -->
        <activity
            android:name=".activities.NearbyHospitalsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Role Selection Screen -->
        <activity
            android:name=".activities.RoleSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Patient Registration -->
        <activity
            android:name=".activities.PatientRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Doctor Registration -->
        <activity
            android:name=".activities.DoctorRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Nurse Registration -->
        <activity
            android:name=".activities.NurseRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Authorized Admin Setup -->
        <activity
            android:name=".activities.AdminSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 9. Forgot Password Screen -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 10. Email Verification Screen -->
        <activity
            android:name=".activities.EmailVerificationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11. Basic Profile Setup & Role Verification Gate -->
        <activity
            android:name=".activities.BasicProfileSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 12. Role-Based Portal & Dashboards (Patient, Doctor, Nurse, Admin) -->
        <activity
            android:name=".activities.RolePortalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 13. Secure One-to-One Doctor-Patient Chat Activity -->
        <activity
            android:name=".activities.SecureChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 14. Hospital Authority Communication Hub -->
        <activity
            android:name=".activities.AuthorityCommunicationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 15. Staff Chat Activity (Groups & 1-to-1) -->
        <activity
            android:name=".activities.StaffChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 16. Billing Checkout Activity -->
        <activity
            android:name=".activities.BillingCheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 17. Digital Receipt Activity -->
        <activity
            android:name=".activities.DigitalReceiptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 18. Hospital Authority Billing Dashboard Activity -->
        <activity
            android:name=".activities.HospitalBillingDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 19. Patient Billing History Activity -->
        <activity
            android:name=".activities.PatientBillingHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 20. Phase 14 Unified Care & Service Tracking Activity -->
        <activity
            android:name=".activities.UnifiedTrackingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 21. Phase 14 Live GPS Telemetry Map Activity -->
        <activity
            android:name=".activities.LiveTrackingMapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Phase 14 Firebase Cloud Messaging Receiver -->
        <service
            android:name=".services.ArohiFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 14. FileProvider for Exported PDF Prescriptions and Diagnostic Reports -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
